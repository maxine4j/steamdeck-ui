{
	"name": "steamdeck-ui",
	"packageManager": "yarn@4.6.0",
	"scripts": {
		"setup": "./scripts/generate-declarations.sh",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"build:lua": "tstl",
		"build": "./scripts/build-addon.sh",
		"lint": "biome check",
		"format": "biome check --write",
		"dev": "tstl --watch"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"lua-types": "^2.14.1",
		"typescript": "6.0.2",
		"typescript-to-lua": "^1.37.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	}
}
